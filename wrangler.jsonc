{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aulora",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "keep_vars": true,
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": true
}
